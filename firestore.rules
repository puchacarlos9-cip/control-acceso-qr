rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /estudiantes/{estudianteId} {
      allow read, write: if true;
    }
    match /usuarios/{usuarioId} {
      allow read, write: if true;
    }
    match /accesos_registrados/{accesoId} {
      allow read, write: if true;
    }
    match /pagos/{pagoId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
